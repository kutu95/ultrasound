# Database (use DATABASE_URL or individual settings)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ultrasound_dev
DATABASE_USER=john
DATABASE_PASSWORD=ultrasound_dev_password

# On the shared server Postgres, set this to isolate the app:
# DATABASE_SCHEMA=ultrasound
DATABASE_SCHEMA=public

# Or as a single connection string:
# DATABASE_URL=postgresql://john:ultrasound_dev_password@localhost:5432/ultrasound_dev

# Server
PORT=3001
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# Initial admin user (created on first server start if none exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Frontend (optional — dev uses Vite proxy; set in production if API is on another host)
# VITE_API_URL=

# Case screenshot uploads (disk storage; not public)
# UPLOAD_DIR=./data/uploads
# MAX_UPLOAD_BYTES=15728640

# ChatGPT Custom GPT Actions (API key for /api/agent/*)
# Generate a long random secret and set the same value in the GPT's Action auth.
# AGENT_API_KEY=
